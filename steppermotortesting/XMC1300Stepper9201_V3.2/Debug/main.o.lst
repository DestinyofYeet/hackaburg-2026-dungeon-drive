 185:../main.c     **** 
 186:../main.c     **** /*High Current Out
 187:../main.c     ****   P1.0,P1.1,P1.2,P1.3,P1.4,P1.5
 188:../main.c     ****   Switching Table for Fullstep and Halfstep
 189:../main.c     ****   Port1 .5,.4,.2,.0
 190:../main.c     ****   Gates  ---- ---- --DC -A-B
 191:../main.c     ****   Port1  0000 0000 0011 0101
 192:../main.c     ****   Gate High = HighSide ON, One halfbridge is controlled by one gate only
 193:../main.c     ****   i.e.: P1.2 controls A and A#  and 0.2 controls B and B#
 194:../main.c     ****   Note P1.2 and P0.2 as well as P1.4 and P0.12 are linked together!
 195:../main.c     ****   Due to this fact diagonal control of the halfbridge is controlled via port config register!
 196:../main.c     ****   Sin-Load current flow from A via RL-Load to B# is defined to be positive dto. for Cos
 197:../main.c     ****   Topology Phase-Sin   VCC
 198:../main.c     ****  			High:	A		B
 199:../main.c     **** 		 	Load:	   -RL-
 200:../main.c     **** 			 Low: 	A#		B#
 201:../main.c     ****       GateControl--P0.7----P0.2
 202:../main.c     **** 		 	 	 	   GND
 203:../main.c     **** 
 204:../main.c     ****   Topology Phase-Cos   VCC
 205:../main.c     ****  			High:	C		D
 206:../main.c     **** 		 	Load:	   -RL-
 207:../main.c     **** 			 Low: 	C#		D#
 208:../main.c     ****       GateControl--P0.8----P0.12
 209:../main.c     **** 		 	 	 	   GND
 210:../main.c     **** */
 211:../main.c     **** 
 212:../main.c     **** 
 213:../main.c     **** 
 214:../main.c     ****   //start SYSTisk
 215:../main.c     ****   //PPB->SYST_RVR = 0x00FFFFFF;    // Systimer auf maxwert
 216:../main.c     ****   //PPB->SYST_CSR = 5;             //Systimer starten
 217:../main.c     ****   //u32LatchStart = PPB->SYST_CVR; //Systimer startwert latchen
 218:../main.c     ****   //atLaufzeiten[0].u32StartWert = PPB->SYST_CVR; //Systimer startwert latchen
 219:../main.c     **** 
 220:../main.c     **** 
 221:../main.c     **** //0x1U:     set P0.12 to high => L/R-Dir Control =1 => pos Current in SIN coil
 222:../main.c     **** //0x10000U: set P0.12 to low  => L/R-Dir Control =1 => neg Current in SIN coil
 223:../main.c     **** //PWM:      0x80:OFF config as digout (was never set), 0xA8:ON config as CCU8out via ALT-Function 5
 224:../main.c     **** 
 225:../main.c     **** //0x1U:     set P0.8 to high  => L/R-Dir Control =1 => pos Current in COS coil
 226:../main.c     **** //0x10000U: set P0.8 to low   => L/R-Dir Control =1 => neg Current in COS coil
 227:../main.c     **** //PWM:      0x80:OFF config as digout (was never set), 0xA8:ON config as CCU8out via ALT-Function 5
 228:../main.c     **** 
 229:../main.c     **** const T_HalfFullSwitchPoint FullStepSwitching[4] =
 230:../main.c     **** {//DIRsin,PWMsin,DIRcos,PWMCos
 231:../main.c     ****  {0x1U    ,0xA8U,0x1U    ,0x80U},	    //DIRsin:+ PWMsin:ON , DIRcos:+, PWMcos:OFF
 232:../main.c     ****  {0x1U    ,0x80U,0x1U    ,0xA8U},	    //DIRsin:+ PWMsin:OFF, DIRcos:+, PWMcos:ON
 233:../main.c     ****  {0x10000U,0xA8U,0x10000U,0x80U},	    //DIRsin:- PWMsin:ON , DIRcos:-, PWMcos:OFF
 234:../main.c     ****  {0x10000U,0x80U,0x10000U,0xA8U}        //DIRsin:- PWMsin:OFF, DIRcos:-, PWMcos:ON
 235:../main.c     **** };
 236:../main.c     **** 
 237:../main.c     **** const T_HalfFullSwitchPoint HalfStepSwitching[8] =
 238:../main.c     **** {//DIRsin,PWMsin,DIRcos,PWMCos
 239:../main.c     ****  {0x1U    ,0xA8U,0x1U    ,0x80U},	    //DIRsin:+ PWMsin:ON , DIRcos:+, PWMcos:OFF  sin+
 240:../main.c     ****  {0x1U    ,0xA8U,0x1U    ,0xA8U},	    //DIRsin:+ PWMsin:ON , DIRcos:+, PWMcos:ON   sin+ cos+
 241:../main.c     **** 
 242:../main.c     ****  {0x10000U,0x80U,0x1U    ,0xA8U},	    //DIRsin:- PWMsin:OFF, DIRcos:+, PWMcos:ON   cos+
 243:../main.c     ****  {0x10000U,0xA8U,0x1U    ,0xA8U},       //DIRsin:- PWMsin:ON , DIRcos:+, PWMcos:ON   cos+ sin-
 244:../main.c     **** 
 245:../main.c     ****  {0x10000U,0xA8U,0x10000U,0x80U},	    //DIRsin:- PWMsin:ON , DIRcos:-, PWMcos:OFF  sin-
 246:../main.c     ****  {0x10000U,0xA8U,0x10000U,0xA8U},	    //DIRsin:- PWMsin:ON , DIRcos:-, PWMcos:ON   sin- cos-
 247:../main.c     **** 
 248:../main.c     ****  {0x1U    ,0x80U,0x10000U,0xA8U},	    //DIRsin:+ PWMsin:OFF, DIRcos:-, PWMcos:ON   cos-
 249:../main.c     ****  {0x1U    ,0xA8U,0x10000U,0xA8U}        //DIRsin:+ PWMsin:ON , DIRcos:-, PWMcos:ON   cos- sin+
 250:../main.c     **** };
