  34:../XMC1000_tseRoutine.c **** Purpose:        Implemetation of fast square root algorithm after Otto Peter's 
  35:../XMC1000_tseRoutine.c ****                 (Otto Peter: Prozessor zieht Wurzel, c't 1990, Heft 1, page 300-306)
  36:../XMC1000_tseRoutine.c ****  
  37:../XMC1000_tseRoutine.c **** @requirements   None   
  38:../XMC1000_tseRoutine.c **** @param          uint32_t    integer number unsigned
  39:../XMC1000_tseRoutine.c **** @return         square root
  40:../XMC1000_tseRoutine.c **** ******************************************************************************/
  41:../XMC1000_tseRoutine.c **** uint32_t sqrt_5(uint32_t x)
  42:../XMC1000_tseRoutine.c **** {
  32              	 .loc 1 42 0
  33              	 .cfi_startproc
  34 0000 80B5     	 push {r7,lr}
  35              	.LCFI0:
  36              	 .cfi_def_cfa_offset 8
  37              	 .cfi_offset 7,-8
  38              	 .cfi_offset 14,-4
  39 0002 86B0     	 sub sp,sp,#24
  40              	.LCFI1:
  41              	 .cfi_def_cfa_offset 32
  42 0004 00AF     	 add r7,sp,#0
  43              	.LCFI2:
  44              	 .cfi_def_cfa_register 7
  45 0006 7860     	 str r0,[r7,#4]
  43:../XMC1000_tseRoutine.c ****     uint32_t xroot, m2, x2;
  44:../XMC1000_tseRoutine.c **** 
  45:../XMC1000_tseRoutine.c ****     xroot = 0;
  46              	 .loc 1 45 0
  47 0008 0023     	 mov r3,#0
  48 000a 7B61     	 str r3,[r7,#20]
  46:../XMC1000_tseRoutine.c ****     m2 = 1 << MAX_BIT * 2;
  49              	 .loc 1 46 0
  50 000c 8023     	 mov r3,#128
  51 000e DB05     	 lsl r3,r3,#23
  52 0010 3B61     	 str r3,[r7,#16]
  53              	.L3:
  47:../XMC1000_tseRoutine.c ****     do
  48:../XMC1000_tseRoutine.c ****     {
  49:../XMC1000_tseRoutine.c **** 		x2 = xroot + m2;
  54              	 .loc 1 49 0
  55 0012 7A69     	 ldr r2,[r7,#20]
  56 0014 3B69     	 ldr r3,[r7,#16]
  57 0016 D318     	 add r3,r2,r3
  58 0018 FB60     	 str r3,[r7,#12]
  50:../XMC1000_tseRoutine.c **** 		xroot >>= 1;
  59              	 .loc 1 50 0
  60 001a 7B69     	 ldr r3,[r7,#20]
  61 001c 5B08     	 lsr r3,r3,#1
  62 001e 7B61     	 str r3,[r7,#20]
  51:../XMC1000_tseRoutine.c **** 		if(x2<=x)
  63              	 .loc 1 51 0
  64 0020 FA68     	 ldr r2,[r7,#12]
  65 0022 7B68     	 ldr r3,[r7,#4]
  66 0024 9A42     	 cmp r2,r3
  67 0026 07D8     	 bhi .L2
  52:../XMC1000_tseRoutine.c **** 		{
  53:../XMC1000_tseRoutine.c **** 			x -= x2; xroot += m2;
  68              	 .loc 1 53 0
  69 0028 7A68     	 ldr r2,[r7,#4]
  70 002a FB68     	 ldr r3,[r7,#12]
  71 002c D31A     	 sub r3,r2,r3
  72 002e 7B60     	 str r3,[r7,#4]
  73 0030 7A69     	 ldr r2,[r7,#20]
  74 0032 3B69     	 ldr r3,[r7,#16]
  75 0034 D318     	 add r3,r2,r3
  76 0036 7B61     	 str r3,[r7,#20]
  77              	.L2:
  54:../XMC1000_tseRoutine.c **** 		}
  55:../XMC1000_tseRoutine.c ****     }while (m2 >>= 2);
  78              	 .loc 1 55 0
  79 0038 3B69     	 ldr r3,[r7,#16]
  80 003a 9B08     	 lsr r3,r3,#2
  81 003c 3B61     	 str r3,[r7,#16]
  82 003e 3B69     	 ldr r3,[r7,#16]
  83 0040 002B     	 cmp r3,#0
  84 0042 E6D1     	 bne .L3
  56:../XMC1000_tseRoutine.c **** 
  57:../XMC1000_tseRoutine.c ****     if(xroot < x) return xroot + 1;		// rounding, necessary
  85              	 .loc 1 57 0
  86 0044 7A69     	 ldr r2,[r7,#20]
  87 0046 7B68     	 ldr r3,[r7,#4]
  88 0048 9A42     	 cmp r2,r3
  89 004a 02D2     	 bcs .L4
  90              	 .loc 1 57 0 is_stmt 0 discriminator 1
  91 004c 7B69     	 ldr r3,[r7,#20]
  92 004e 0133     	 add r3,r3,#1
  93 0050 00E0     	 b .L5
  94              	.L4:
  58:../XMC1000_tseRoutine.c **** 
  59:../XMC1000_tseRoutine.c ****     return xroot;
  95              	 .loc 1 59 0 is_stmt 1
  96 0052 7B69     	 ldr r3,[r7,#20]
  97              	.L5:
  60:../XMC1000_tseRoutine.c **** }
  98              	 .loc 1 60 0
  99 0054 181C     	 mov r0,r3
 100 0056 BD46     	 mov sp,r7
 101 0058 06B0     	 add sp,sp,#24
 102              	 
 103 005a 80BD     	 pop {r7,pc}
 104              	 .cfi_endproc
