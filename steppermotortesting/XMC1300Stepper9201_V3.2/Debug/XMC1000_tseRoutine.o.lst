  18:../XMC1000_tseRoutine.c **** // fast square root algorithm taken from 
  19:../XMC1000_tseRoutine.c **** // Otto Peter: Prozessor zieht Wurzel, c't 1990, Heft 1, page 300-306
  20:../XMC1000_tseRoutine.c **** #define N_BITS 32
  21:../XMC1000_tseRoutine.c **** #define MAX_BIT ((N_BITS + 1) / 2 - 1)
  22:../XMC1000_tseRoutine.c **** 
